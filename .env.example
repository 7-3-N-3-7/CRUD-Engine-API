# =============================================================================
#  CRUD Engine — Environment Configuration
#  Copy this file to .env and fill in your own values.
#  NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# ── Docker Hub ────────────────────────────────────────────────────────────────
# Your Docker Hub username (used by build-and-push.sh and docker-compose)
DOCKER_USERNAME=your_dockerhub_username

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=crudapp_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_db_password

# Secondary database created for Keycloak (inside the same Postgres instance)
POSTGRES_KEYCLOAK_DB=crudapp_keycloak_db

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_DB=crudapp_db

# ── Keycloak ──────────────────────────────────────────────────────────────────
# Admin console credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_strong_keycloak_admin_password

# Realm name (must match the value in realm-export.json)
KEYCLOAK_REALM=crud-realm

# Application users — passwords are seeded into Keycloak on first import
KC_ROOT_USER_PASSWORD=your_root_password
KC_ADMIN_USER_PASSWORD=your_admin_user_password
KC_REGULAR_USER_PASSWORD=your_regular_user_password

# Service-account client secret (used by CI scripts / test-products.ps1)
KC_TEST_CLIENT_SECRET=your_test_client_secret

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=your_minio_admin
MINIO_ROOT_PASSWORD=your_strong_minio_password

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Internal URL used by the Next.js Node server to proxy /api/* requests.
# Locally: http://localhost:8080
# In Docker: http://crud-api:8080  (uses the docker-compose service name)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081/auth

# ── Swagger UI ────────────────────────────────────────────────────────────────
SWAGGER_UI_PORT=8082
