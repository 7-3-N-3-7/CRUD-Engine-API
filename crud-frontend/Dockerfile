# =============================================================================
#  Multi-stage Dockerfile for the Next.js SSR frontend
#  Stage 1 — Build:  compiles TypeScript & generates .next production bundle
#  Stage 2 — Runner: minimal Node.js image that serves the Next.js app
# =============================================================================

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (layer-cached unless package.json changes)
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy source and build
COPY . .
RUN npm run build

# ── Stage 2: Runner ───────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy only what Next.js needs to run in production
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

# next start is replaced by the standalone server.js generated by Next.js
CMD ["node", "server.js"]
