@startuml RateLimiter Class Diagram
skinparam classAttributeIconSize 0

package org.springframework.web.server {
  interface WebFilter {
    + filter(ServerWebExchange, WebFilterChain): Mono<Void>
  }
}

package com.org73n37.crudapp.infrastructure.web {
  class ReactiveRateLimiterFilter implements WebFilter {
    - {static} MAX_TOKENS : int = 50
    - {static} REFILL_DURATION_MS : long = 60000
    - Map<String, TokenBucket> ipBuckets
    - AppModeConfig appModeConfig
    - forceRateLimit : boolean
    + filter(ServerWebExchange, WebFilterChain): Mono<Void>
    + isForceRateLimit(): boolean
    + setForceRateLimit(boolean): void
    + reset(): void
  }
  
  class TokenBucket {
    - capacity : int
    - refillDurationMs : long
    - tokens : double
    - lastRefillTime : long
    + tryConsume(): boolean
    - refill(): void
  }
}

ReactiveRateLimiterFilter +-- TokenBucket : "manages per IP"
@enduml
