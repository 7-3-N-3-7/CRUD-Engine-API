<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<groupId>com.org73n37</groupId>
	<artifactId>crudapp-parent</artifactId>
	<version>0.1.0</version>
	<packaging>pom</packaging>
	<name>crudapp-parent</name>
	<description>Generic CRUD application - Parent POM</description>
	
	<modules>
		<module>crud-engine-core</module>
		<module>crud-engine-jpa</module>
		<module>crud-engine-inmemory</module>
		<module>crud-engine-weaviate</module>
		<module>crud-engine-webflux</module>
		<module>crud-engine-security-keycloak</module>
		<module>crud-engine-plugin-ratelimiter</module>
		<module>crud-engine-plugin-auditlog</module>
		<module>crud-engine-spring-boot-starter</module>
		<module>crud-app-sample</module>
	</modules>

	<properties>
		<java.version>22</java.version>
		<maven.compiler.release>25</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spring-boot.version>4.0.6</spring-boot.version>
		<junit-jupiter.version>6.1.0</junit-jupiter.version>
		<byte-buddy.version>1.17.7</byte-buddy.version>
		<jjwt.version>0.13.0</jjwt.version>
		<jackson.version>3.1.4</jackson.version>
		<!--
			Jackson 3.x (tools.jackson) intentionally keeps its annotations under the
			legacy com.fasterxml.jackson.core:jackson-annotations coordinates. jjwt-jackson
			transitively pulls an older 2.12.x jackson-annotations that lacks classes such as
			JsonSerializeAs, which Jackson 3 requires. Pin annotations to the version Jackson
			3.x expects so it wins dependency mediation across all modules.
		-->
		<jackson-annotations.version>2.21</jackson-annotations.version>
		<springdoc.version>2.5.0</springdoc.version>
		<cucumber.version>7.18.0</cucumber.version>
		<jacoco.version>0.8.12</jacoco.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Spring Boot Starters -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-data-jpa</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-validation</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-security</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-json</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-webflux</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-thymeleaf</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-liquibase</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-actuator</artifactId>
				<version>${spring-boot.version}</version>
			</dependency>

			<!-- Core Engine Submodules -->
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-jpa</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-inmemory</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-weaviate</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-webflux</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-security-keycloak</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-plugin-ratelimiter</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-plugin-auditlog</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.org73n37</groupId>
				<artifactId>crud-engine-spring-boot-starter</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Database & Persistence -->
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>42.7.11</version>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>org.liquibase</groupId>
				<artifactId>liquibase-core</artifactId>
				<version>5.0.3</version>
			</dependency>

			<!-- JSON Handling -->
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<!--
				Jackson 3 stores its annotations under the legacy com.fasterxml.jackson.core
				coordinates. Force the version Jackson 3.x requires so the older copy pulled
				in transitively by jjwt-jackson does not shadow it (missing JsonSerializeAs).
			-->
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-annotations</artifactId>
				<version>${jackson-annotations.version}</version>
			</dependency>
			<!-- Spring Boot Actuator requires Jackson 2. Pin to 2.18.2 so jjwt-jackson doesn't downgrade it -->
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>2.18.2</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>2.18.2</version>
			</dependency>

			<!-- Security (JWT) -->
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${jjwt.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${jjwt.version}</version>
				<scope>runtime</scope>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${jjwt.version}</version>
				<scope>runtime</scope>
			</dependency>

			<!-- Runtime Class Generation -->
			<dependency>
				<groupId>net.bytebuddy</groupId>
				<artifactId>byte-buddy</artifactId>
				<version>${byte-buddy.version}</version>
			</dependency>

			<!-- Test -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-test</artifactId>
				<version>${spring-boot.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-api</artifactId>
				<version>${junit-jupiter.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit-jupiter.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- OpenAPI / Swagger -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>

			<!-- Cucumber BDD -->
			<dependency>
				<groupId>io.cucumber</groupId>
				<artifactId>cucumber-java</artifactId>
				<version>${cucumber.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>io.cucumber</groupId>
				<artifactId>cucumber-spring</artifactId>
				<version>${cucumber.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>io.cucumber</groupId>
				<artifactId>cucumber-junit-platform-engine</artifactId>
				<version>${cucumber.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.junit.platform</groupId>
				<artifactId>junit-platform-suite</artifactId>
				<version>${junit-jupiter.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${spring-boot.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<release>${maven.compiler.release}</release>
					<encoding>${project.build.sourceEncoding}</encoding>
					<parameters>true</parameters>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.4</version>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
