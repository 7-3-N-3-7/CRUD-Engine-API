<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="baseentity"/>
            </not>
        </preConditions>
        <!-- Create baseentity table -->
        <createTable tableName="baseentity">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parent_id" type="bigint">
                <constraints foreignKeyName="fk_baseentity_parent" referencedTableName="baseentity" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product"/>
            </not>
        </preConditions>
        <!-- Create product table (JOINED inheritance subclass) -->
        <createTable tableName="product">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_product_baseentity" referencedTableName="baseentity" referencedColumnNames="id"/>
            </column>
            <column name="name" type="varchar(255)"/>
            <column name="description" type="varchar(255)"/>
            <column name="price" type="double precision"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="team">
        <addColumn tableName="baseentity">
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(255)"/>
            <column name="last_modified_date" type="timestamp"/>
            <column name="tenant_id" type="varchar(255)" defaultValue="default">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="4" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="entity_attributes"/>
            </not>
        </preConditions>
        <createTable tableName="entity_attributes">
            <column name="entity_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_attributes_baseentity" referencedTableName="baseentity" referencedColumnNames="id"/>
            </column>
            <column name="attribute_key" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="attribute_value" type="varchar(2000)"/>
        </createTable>
        <addPrimaryKey tableName="entity_attributes" columnNames="entity_id, attribute_key" constraintName="pk_entity_attributes"/>
    </changeSet>

</databaseChangeLog>
