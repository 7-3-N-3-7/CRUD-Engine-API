<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="baseentity"/>
            </not>
        </preConditions>
        <!-- Create baseentity table -->
        <createTable tableName="baseentity">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parent_id" type="bigint">
                <constraints foreignKeyName="fk_baseentity_parent" referencedTableName="baseentity" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="product"/>
            </not>
        </preConditions>
        <!-- Create product table (JOINED inheritance subclass) -->
        <createTable tableName="product">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" foreignKeyName="fk_product_baseentity" referencedTableName="baseentity" referencedColumnNames="id"/>
            </column>
            <column name="name" type="varchar(255)"/>
            <column name="description" type="varchar(255)"/>
            <column name="price" type="double precision"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
